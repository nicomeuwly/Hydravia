    "watch.setupBody" : {
      "comment" : "Before the iPhone has sent anything",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Uhr zeigt dann dein Wasser von heute."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your watch will then show today's water."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu reloj mostrará luego el agua de hoy."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta montre affichera ensuite ton eau du jour."
          }
        }
      }
    },
    "watch.proTitle" : {
      "comment" : "Free plan: why there are no pour buttons",
