    "watch.proBody" : {
      "comment" : "Free plan: why there are no pour buttons",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eintragen auf der Uhr gehört zu Hydravia Pro. Wechsle in der iPhone-App zu Pro."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Logging from the watch is part of Hydravia Pro. Go Pro in the iPhone app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registrar desde el reloj forma parte de Hydravia Pro. Hazte Pro en la app del iPhone."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'ajout depuis la montre fait partie d'Hydravia Pro. Passe Pro dans l'app iPhone."
          }
        }
      }
    }
