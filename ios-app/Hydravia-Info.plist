<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged into the generated Info.plist (GENERATE_INFOPLIST_FILE): keys
	     Xcode has no INFOPLIST_KEY_ build setting for. Kept outside the
	     synchronized Hydravia/ folder so it isn't copied as a resource. -->
	<!-- The weather needs a town, not an address: ask for approximate
	     location by default. -->
	<key>NSLocationDefaultAccuracyReduced</key>
	<true/>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.nicomeuwly.hydravia.reminders-refresh</string>
	</array>
	<!-- hydravia:// links (AppRouter.open): widgets, and the deep links of
	     App Store in-app events. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.nicomeuwly.hydravia</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>hydravia</string>
			</array>
		</dict>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
	</array>
</dict>
</plist>
