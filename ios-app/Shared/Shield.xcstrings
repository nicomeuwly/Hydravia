            "value": "OK"
          }
        }
      }
    },
    "shield.tempUnlockSubtitle": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Pause startet. Versuch es gleich noch einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your break is starting. Try again in a second."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu pausa se está activando. Inténtalo en un segundo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta pause s’active. Réessaie dans une seconde."
          }
        }
      }
    },
    "shield.tempUnlockTitle": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles klar!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All set!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Listo!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C’est tout bon !"
          }
        }
      }
    },
    "shield.thisApp": {
      "comment": "Shield subtitle fallback when the system gives no app name.",
