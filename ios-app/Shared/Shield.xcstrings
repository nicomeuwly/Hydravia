{
  "sourceLanguage": "en",
  "strings": {
    "shield.notifBody": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe hier: trinken, und alles ist wieder frei."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap here: drink, and everything unlocks."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca aquí: bebes y todo se desbloquea."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche ici : tu bois, tout se débloque."
          }
        }
      }
    },
    "shield.notifTitle": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Portion wartet 💧"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your dose is waiting 💧"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu dosis te espera 💧"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton verre t’attend 💧"
          }
        }
      }
    },
    "shield.primaryButton": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trinken"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drink now"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A beber"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bois"
          }
        }
      }
    },
    "shield.progress.done": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tagesziel erreicht 🎉 Bleib dran."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today's goal reached 🎉 Keep it up."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Objetivo de hoy logrado 🎉 Sigue así."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Objectif du jour atteint 🎉 Garde le rythme."
          }
        }
      }
    },
    "shield.progress.first": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heute noch kein Tropfen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not a drop yet today."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ni una gota todavía hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore une goutte aujourd'hui."
          }
        }
      }
    },
    "shield.progress.remaining": {
      "comment": "%1$@ = formatted millilitres",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch %1$@ ml bis zu deinem Tagesziel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ml to go for today's goal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te faltan %1$@ ml para tu objetivo de hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Encore %1$@ ml pour ton objectif du jour."
          }
        }
      }
    },
    "shield.progress.streak": {
      "comment": "%1$d = streak days, %2$@ = formatted millilitres",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "🔥 %1$d Tage in Folge · heute noch %2$@ ml."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "🔥 %1$d-day streak · %2$@ ml to go today."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "🔥 Racha de %1$d días · hoy te faltan %2$@ ml."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "🔥 Série de %1$d jours · encore %2$@ ml aujourd'hui."
          }
        }
      }
    },
    "shield.secondaryButton": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Später"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Later"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Más tarde"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus tard"
          }
        }
      }
    },
    "shield.subtitle": {
      "comment": "Arguments: appName",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ wartet, bis du getrunken hast."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is waiting until you drink."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ esperará a que bebas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ attendra que tu aies bu."
          }
        }
      }
    },
    "shield.tempUnlockButton": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "OK"
          }
        },
        "en": {
