    "notifPrime.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei jeder Erinnerung pausiert Hydravia die Apps, die du ausgewählt hast. Zum Öffnen trinkst du genau so viel, wie du brauchst — nicht mehr, nicht weniger."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At every reminder, Hydravia pauses the apps you picked. To open them again, you drink just what you need — no more, no less."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En cada recordatorio, Hydravia pone en pausa las apps que elegiste. Para volver a abrirlas, bebes justo lo que necesitas, ni más ni menos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À chaque rappel, Hydravia met en pause les apps que tu as choisies. Pour les rouvrir, tu bois juste ce qu’il te faut, ni trop ni trop peu."
          }
        }
      }
    },
