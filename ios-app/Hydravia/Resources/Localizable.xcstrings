    "screenTime.bodyIos" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für das Sperren deiner Apps bei Erinnerungen ist eine Systemberechtigung nötig. Ohne sie funktioniert die App weiterhin — nur ohne Sperre."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A system permission is needed to lock your apps when reminders fire. Without it the app still works, just without the lock."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se necesita un permiso del sistema para bloquear tus apps cuando llegan los recordatorios. Sin él la app funciona, pero sin el bloqueo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une autorisation système est nécessaire pour verrouiller tes apps au moment des rappels. Sans elle, l'app fonctionne, mais sans le verrou."
          }
        }
      }
    },
