    "notif.reminderBody1" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schluss mit Scrollen. Eine Portion Wasser und deine Apps gehören dir."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stop scrolling. One dose of water and your apps are yours."
