    "location.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit deinem Standort erhöht Hydravia deine Dosen an heißen Tagen. Du trinkst etwas mehr, wenn es heiß ist – ganz ohne darüber nachzudenken."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With your location, Hydravia raises your doses on hot days. You drink a little more when it's hot, without even thinking about it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con tu ubicación, Hydravia sube tus dosis los días de calor. Bebes un poco más cuando hace calor, sin siquiera pensarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec ta position, Hydravia ajuste ton verre les jours de chaleur. Tu bois un peu plus quand il fait chaud, sans même y penser."
          }
        }
      }
    },
