    "screenTime.step1Ios" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das System fragt nach Zugriff auf die Bildschirmzeit. Das ist die Apple-Funktion, die Apps sperren kann."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The system will ask for Screen Time access. That's the Apple feature that can block apps."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El sistema pedirá acceso a Tiempo de uso. Es la función de Apple que permite bloquear apps."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le système te demandera l'accès au Temps d'écran. C'est la fonctionnalité Apple qui permet de bloquer des apps."
          }
        }
      }
    },
    "screenTime.step2Ios" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hydravia sieht keine deiner Bildschirmzeit-Daten. Es aktiviert nur die Sperre im richtigen Moment."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hydravia cannot see any of your Screen Time data. It only turns the lock on at the right moment."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hydravia no puede ver ninguno de tus datos de Tiempo de uso. Solo activa el bloqueo en el momento adecuado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hydravia ne peut voir aucune de tes données de Temps d'écran. Il se contente d'activer le verrou au bon moment."
          }
        }
      }
    },
    "screenTime.step3Ios" : {
