    "health.disclaimer" : {
      "comment" : "Settings › About footer. Required by App Review guideline 1.4.1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hydravia gibt allgemeine Trinkempfehlungen und ersetzt keinen ärztlichen Rat. Bei Erkrankungen, in der Schwangerschaft oder bei Medikamenteneinnahme frag eine medizinische Fachkraft."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hydravia gives general hydration guidance and is not medical advice. If you have a health condition, are pregnant or take medication, ask a healthcare professional."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hydravia ofrece pautas generales de hidratación y no sustituye el consejo médico. Si tienes un problema de salud, un embarazo o tomas medicación, consulta a un profesional sanitario."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hydravia donne des repères généraux d’hydratation et ne remplace pas un avis médical. En cas de problème de santé, de grossesse ou de traitement, demande conseil à un professionnel de santé."
          }
        }
      }
    },
    "health.disclaimerShort" : {
      "comment" : "Under the computed daily goal (onboarding goal reveal).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Richtwert, kein ärztlicher Rat."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A general guide, not medical advice."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una referencia orientativa, no un consejo médico."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un repère indicatif, pas un avis médical."
          }
        }
      }
    },
