    "welcome.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Trinkritual, kein Zähler. Bei jeder Erinnerung machen die Apps, die du ausgewählt hast, Pause. Trink deine Portion Wasser und sie öffnen sich wieder. Ganz einfach."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A hydration ritual, not a tracker. At every reminder, the apps you picked take a break. Drink your dose of water and they open again. That's it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un ritual de hidratación, no un contador. En cada recordatorio, las apps que elegiste se ponen en pausa. Bebe tu dosis de agua y vuelven a abrirse. Así de simple."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un rituel d’hydratation, pas un compteur. À chaque rappel, les apps que tu as choisies se mettent en pause. Bois ton verre d’eau et elles se rouvrent, tout simplement."
          }
        }
      }
    },
