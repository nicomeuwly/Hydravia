---
/**
 * The home page body, shared by /fr and /en.
 *
 * Both language routes render this with a different `lang`, so the structure
 * exists once and the copy comes entirely from src/i18n. Adding a language
 * later means adding a catalogue, not copying this file.
 *
 * Motion: sections fade up as they scroll into view (`data-reveal`), the hero
 * has moving waves and rising bubbles like the app's home screen. Everything still reads without JavaScript, and
 * `prefers-reduced-motion` turns it all into a static page.
 */
import Phone from './Phone.astro';
import AppStoreButton from './AppStoreButton.astro';
import { t, localePath, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const locale = lang === 'fr' ? 'fr-FR' : 'en-US';
const ml = (n: number) => n.toLocaleString(locale);

const titleLines = t(lang, 'hero.title').split('\n');

const steps = [
  { n: '01', title: t(lang, 'how.step1.title'), body: t(lang, 'how.step1.body') },
  { n: '02', title: t(lang, 'how.step2.title'), body: t(lang, 'how.step2.body') },
  { n: '03', title: t(lang, 'how.step3.title'), body: t(lang, 'how.step3.body') },
];

const features = [
  { title: t(lang, 'feat.dose.title'), body: t(lang, 'feat.dose.body'), icon: 'dose' },
  { title: t(lang, 'feat.lock.title'), body: t(lang, 'feat.lock.body'), icon: 'lock' },
  { title: t(lang, 'feat.pause.title'), body: t(lang, 'feat.pause.body'), icon: 'moon' },
  { title: t(lang, 'feat.streak.title'), body: t(lang, 'feat.streak.body'), icon: 'chart' },
];

// Real captures from the simulator in their device mockups, one set per
// language (sources in captures/).
const shots = {
  home: 'iphone-1-home',
  unlock: 'iphone-2-thirst',
  'unlock-dose': 'iphone-3-dose',
  history: 'iphone-4-history',
  widgets: 'iphone-5-widgets',
  'watch-ring': 'watch-1-ring',
  'watch-pour': 'watch-2-pour',
} as const;
const shot = (name: keyof typeof shots) => `/shots/${lang}/mockup-${shots[name]}.webp`;

const freeItems = ['price.free.f1', 'price.free.f2', 'price.free.f3', 'price.free.f4'] as const;
const proItems = ['price.pro.f1', 'price.pro.f2', 'price.pro.f3', 'price.pro.f4'] as const;

const faqs = [
  { q: t(lang, 'faq.q1'), a: t(lang, 'faq.a1') },
  { q: t(lang, 'faq.q2'), a: t(lang, 'faq.a2') },
  { q: t(lang, 'faq.q7'), a: t(lang, 'faq.a7') },
  { q: t(lang, 'faq.q6'), a: t(lang, 'faq.a6') },
  { q: t(lang, 'faq.q3'), a: t(lang, 'faq.a3') },
  { q: t(lang, 'faq.q4'), a: t(lang, 'faq.a4') },
  { q: t(lang, 'faq.q5'), a: t(lang, 'faq.a5') },
];

const privacyPoints = [
  t(lang, 'privacy.p1'),
  t(lang, 'privacy.p2'),
  t(lang, 'privacy.p3'),
  t(lang, 'privacy.p4'),
];

// FAQPage structured data, generated from the same array the page renders, so
// the two can never disagree.
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

// Rising bubbles, drawn like the app's ambient ones (WaterPhysics): flat
// white discs, 5 to 16 points, each with its own opacity (0.12 to 0.36) so
// some read further back; the bigger ones rise faster, all wobble a little.
// A negative delay so the hero is already busy on first paint.
const bubbles = [
  { x: 6, s: 9, a: 0.22, o: -3 },
  { x: 13, s: 15, a: 0.3, o: -11 },
  { x: 21, s: 6, a: 0.14, o: -6 },
  { x: 30, s: 12, a: 0.34, o: -15 },
  { x: 39, s: 7, a: 0.18, o: -2 },
  { x: 47, s: 16, a: 0.26, o: -9 },
  { x: 55, s: 5, a: 0.12, o: -13 },
  { x: 63, s: 11, a: 0.2, o: -4 },
  { x: 71, s: 8, a: 0.36, o: -8 },
  { x: 79, s: 14, a: 0.16, o: -12 },
  { x: 87, s: 6, a: 0.28, o: -1 },
  { x: 94, s: 10, a: 0.2, o: -7 },
].map((b, i) => ({
  ...b,
  // Speed grows with size, as in the app.
  d: (26 - b.s * 0.75).toFixed(1),
  // Wobble: 2 to 7 px, its own period.
  w: 2 + (i * 5) % 6,
  p: (1.8 + (i % 4) * 0.45).toFixed(2),
}));
const bubbleStyle = (b: (typeof bubbles)[number], x = b.x) =>
  `--x:${x}%;--s:${b.s}px;--a:${b.a};--d:${b.d}s;--o:${b.o}s;--w:${b.w}px;--p:${b.p}s`;

// One wave period is 1440 wide; the path holds two so it can slide by half
// its width and loop without a seam.
const wavePath =
  'M0,60 C240,100 480,20 720,60 C960,100 1200,20 1440,60 C1680,100 1920,20 2160,60 C2400,100 2640,20 2880,60 L2880,120 L0,120 Z';
---

<!-- Set before the sections parse, so hidden-until-revealed content is only
     ever hidden when the script that reveals it can run. -->
<script is:inline>document.documentElement.classList.add('js');</script>

<!-- ═══ Hero ═══ -->
<section class="hero">
  <div class="bubbles" aria-hidden="true">
    {
      bubbles.map((b) => (
        <span class="bubble" style={bubbleStyle(b)} />
      ))
    }
  </div>

  <div class="wrap hero-in">
    <div class="hero-copy">
      <p class="badge enter" style="--i:0">{t(lang, 'hero.badge')}</p>
      <h1>
        {
          titleLines.map((line, i) => (
            <span class="line enter" style={`--i:${i + 1}`}>
              {line}
            </span>
          ))
        }
      </h1>
      <p class="lede enter" style="--i:4">{t(lang, 'hero.body')}</p>
      <div class="hero-cta enter" style="--i:5">
        <AppStoreButton label={t(lang, 'hero.cta')} variant="light" soon={t(lang, 'hero.soon')} />
        <p class="note">{t(lang, 'hero.ctaNote')}</p>
      </div>
    </div>
    <div class="hero-shot">
      <div class="glow" aria-hidden="true"></div>
      <div class="float">
        <Phone src={shot('home')} alt={t(lang, 'hero.shotAlt')} priority />
      </div>
      <p class="chip" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="11" width="18" height="11" rx="2"></rect>
          <path d="M7 11V7a5 5 0 0 1 9.9-1"></path>
        </svg>
        <strong>+{ml(140)} ml</strong>
        <span>{t(lang, 'hero.chip')}</span>
      </p>
    </div>
  </div>

  <!-- Decorative waves, echoing the rising water inside the app. -->
  <div class="waves" aria-hidden="true">
    <svg class="wave back" viewBox="0 0 2880 120" preserveAspectRatio="none">
      <path d={wavePath}></path>
    </svg>
    <svg class="wave front" viewBox="0 0 2880 120" preserveAspectRatio="none">
      <path d={wavePath}></path>
    </svg>
  </div>
</section>

<!-- ═══ Problem ═══ -->
<section class="problem">
  <div class="wrap narrow">
    <h2 data-reveal>{t(lang, 'problem.title')}</h2>
    <p class="body" data-reveal style="--i:1">{t(lang, 'problem.body')}</p>
    <p class="kicker" data-reveal style="--i:2">{t(lang, 'problem.kicker')}</p>
  </div>
</section>

<!-- ═══ How it works ═══ -->
<section id="how" class="how">
  <div class="wrap">
    <p class="eyebrow" data-reveal>{t(lang, 'how.eyebrow')}</p>
    <h2 class="sec-title" data-reveal style="--i:1">{t(lang, 'how.title')}</h2>

    <div class="how-grid">
      <ol class="steps">
        {
          steps.map((s, i) => (
            <li data-reveal style={`--i:${i + 1}`}>
              <span class="step-n">{s.n}</span>
              <div>
                <h3>{s.title}</h3>
                <p>{s.body}</p>
              </div>
            </li>
          ))
        }
      </ol>

      <div class="how-shots" data-reveal="tilt">
        <Phone src={shot('unlock')} alt={t(lang, 'how.shotAlt')} class="shot-a" />
        <Phone src={shot('unlock-dose')} alt={t(lang, 'how.doseAlt')} class="shot-b" />
      </div>
    </div>
  </div>
</section>

<!-- ═══ Features ═══ -->
<section id="features" class="features">
  <div class="wrap">
    <p class="eyebrow" data-reveal>{t(lang, 'feat.eyebrow')}</p>
    <h2 class="sec-title" data-reveal style="--i:1">{t(lang, 'feat.title')}</h2>

    <div class="feat-layout">
      <ul class="feat-grid">
        {
          features.map((f, i) => (
            <li class="card" data-reveal style={`--i:${i}`}>
              <span class="ficon" aria-hidden="true">
                {f.icon === 'dose' && (
                  <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 2.7S5 10.5 5 15a7 7 0 0 0 14 0c0-4.5-7-12.3-7-12.3Z" />
                  </svg>
                )}
                {f.icon === 'lock' && (
                  <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="11" width="18" height="11" rx="2" />
                    <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                  </svg>
                )}
                {f.icon === 'moon' && (
                  <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" />
                  </svg>
                )}
                {f.icon === 'chart' && (
                  <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M6 20V10M12 20V4M18 20v-6" />
                  </svg>
                )}
              </span>
              <h3>{f.title}</h3>
              <p>{f.body}</p>
            </li>
          ))
        }
      </ul>

      <div class="feat-shot" data-reveal="tilt">
        <Phone src={shot('history')} alt={t(lang, 'feat.streakAlt')} />
      </div>
    </div>
  </div>
</section>

<!-- ═══ Widgets & Apple Watch ═══ -->
<section class="every">
  <div class="wrap">
    <p class="eyebrow" data-reveal>{t(lang, 'every.eyebrow')}</p>
    <h2 class="sec-title" data-reveal style="--i:1">{t(lang, 'every.title')}</h2>

    <div class="every-grid">
      <article class="every-col" data-reveal>
        <div class="widget-stage">
          <Phone src={shot('widgets')} alt={t(lang, 'every.widgetAlt')} class="widget-phone" />
        </div>
        <h3>{t(lang, 'every.widgets.title')}</h3>
        <p>{t(lang, 'every.widgets.body')}</p>
      </article>

      <article class="every-col" data-reveal style="--i:1">
        <div class="watch-stage">
          <div class="watch">
            <img
              src={shot('watch-ring')}
              alt={t(lang, 'every.watchAlt')}
              width="567"
              height="891"
              loading="lazy"
              decoding="async"
            />
            <img
              class="watch-next"
              src={shot('watch-pour')}
              alt=""
              width="567"
              height="891"
              loading="lazy"
              decoding="async"
            />
          </div>
        </div>
        <h3>{t(lang, 'every.watch.title')}</h3>
        <p>{t(lang, 'every.watch.body')}</p>
      </article>
    </div>
  </div>
</section>

<!-- ═══ Pricing ═══ -->
<section id="pricing" class="pricing">
  <div class="wrap">
    <p class="eyebrow" data-reveal>{t(lang, 'price.eyebrow')}</p>
    <h2 class="sec-title" data-reveal style="--i:1">{t(lang, 'price.title')}</h2>

    <div class="plans">
      <article class="plan" data-reveal>
        <h3>{t(lang, 'price.free.name')}</h3>
        <p class="price">
          <strong>{t(lang, 'price.free.price')}</strong>
          <span>{t(lang, 'price.free.per')}</span>
        </p>
        <ul>
          {
            freeItems.map((k) => (
              <li>
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M20 6 9 17l-5-5" />
                </svg>
                <span>{t(lang, k)}</span>
              </li>
            ))
          }
        </ul>
      </article>

      <article class="plan pro" data-reveal style="--i:1">
        <h3>{t(lang, 'price.pro.name')}</h3>
        <p class="price">
          <strong>{t(lang, 'price.pro.price')}</strong>
          <span>{t(lang, 'price.pro.per')}</span>
        </p>
        <p class="alt">{t(lang, 'price.pro.alt')}</p>
        <p class="lead">{t(lang, 'price.pro.lead')}</p>
        <ul>
          {
            proItems.map((k) => (
              <li>
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M20 6 9 17l-5-5" />
                </svg>
                <span>{t(lang, k)}</span>
              </li>
            ))
          }
        </ul>
        <p class="trial">{t(lang, 'price.pro.trial')}</p>
      </article>
    </div>
    <p class="price-note" data-reveal>{t(lang, 'price.note')}</p>
  </div>
</section>

<!-- ═══ Privacy ═══ -->
<section class="privacy">
  <div class="wrap privacy-in">
    <h2 data-reveal>{t(lang, 'privacy.title')}</h2>
    <ul>
      {
        privacyPoints.map((p, i) => (
          <li data-reveal style={`--i:${i}`}>
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20 6 9 17l-5-5" />
            </svg>
            <span>{p}</span>
          </li>
        ))
      }
    </ul>
    <a class="privacy-link" href={localePath(lang, '/privacy')}>
      {t(lang, 'privacy.link')} →
    </a>
  </div>
</section>

<!-- ═══ FAQ ═══ -->
<section id="faq" class="faq">
  <div class="wrap narrow">
    <p class="eyebrow" data-reveal>{t(lang, 'faq.eyebrow')}</p>
    <h2 class="sec-title" data-reveal style="--i:1">{t(lang, 'faq.title')}</h2>
    <div class="faq-list">
      {
        faqs.map((f, i) => (
          <details data-reveal style={`--i:${Math.min(i, 4)}`}>
            <summary>
              <span>{f.q}</span>
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
                <path d="m6 9 6 6 6-6" />
              </svg>
            </summary>
            <p>{f.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<!-- ═══ Final CTA ═══ -->
<section class="final">
  <div class="waves top" aria-hidden="true">
    <svg class="wave back" viewBox="0 0 2880 120" preserveAspectRatio="none">
      <path d={wavePath}></path>
    </svg>
    <svg class="wave front" viewBox="0 0 2880 120" preserveAspectRatio="none">
      <path d={wavePath}></path>
    </svg>
  </div>
  <div class="bubbles" aria-hidden="true">
    {
      bubbles.filter((_, i) => i % 2 === 0).map((b) => (
        <span class="bubble" style={bubbleStyle(b, b.x * 1.6)} />
      ))
    }
  </div>
  <div class="wrap final-in">
    <h2 data-reveal>{t(lang, 'final.title')}</h2>
    <p data-reveal style="--i:1">{t(lang, 'final.body')}</p>
    <div data-reveal style="--i:2">
      <AppStoreButton label={t(lang, 'hero.cta')} variant="light" soon={t(lang, 'hero.soon')} />
    </div>
    <p class="note">{t(lang, 'hero.ctaNote')}</p>
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />

<script>
  const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // ── Reveal on scroll ──
  const targets = document.querySelectorAll<HTMLElement>('[data-reveal]');
  if (still || !('IntersectionObserver' in window)) {
    targets.forEach((el) => el.classList.add('is-in'));
  } else {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add('is-in');
          io.unobserve(entry.target);
        }
      },
      { rootMargin: '0px 0px -8% 0px', threshold: 0.12 },
    );
    targets.forEach((el) => io.observe(el));
  }
</script>

<style>
  /* ── Shared section furniture ── */
  .eyebrow {
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: 0.16em;
    color: var(--accent-cyan);
    margin: 0 0 12px;
  }
  .sec-title {
    font-size: clamp(28px, 4.4vw, 42px);
    margin-bottom: 44px;
    max-width: 20ch;
  }
  .narrow {
    max-width: 760px;
  }
  section {
    padding-block: clamp(64px, 9vw, 108px);
  }

  /* ── Motion: reveal on scroll ── */
  :global(html.js) [data-reveal] {
    opacity: 0;
    transform: translateY(26px);
    transition:
      opacity 0.7s ease,
      transform 0.8s cubic-bezier(0.2, 0.7, 0.2, 1);
    transition-delay: calc(var(--i, 0) * 90ms);
  }
  :global(html.js) [data-reveal='tilt'] {
    transform: translateY(40px) rotate(3deg) scale(0.96);
  }
  :global(html.js) [data-reveal].is-in {
    opacity: 1;
    transform: none;
  }

  /* Load-time entrance for the hero, which is already on screen. */
  .enter {
    animation: rise-in 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    animation-delay: calc(0.1s + var(--i, 0) * 0.11s);
  }
  @keyframes rise-in {
    from {
      opacity: 0;
      transform: translateY(22px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* ── Bubbles ── */
  .bubbles {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }
  .bubble {
    position: absolute;
    left: var(--x);
    bottom: -20px;
    width: var(--s);
    height: var(--s);
    opacity: 0;
    animation: bubble-rise var(--d) linear var(--o) infinite;
  }
  .bubble::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: #fff;
    animation: bubble-wobble var(--p) ease-in-out infinite alternate;
  }
  /* Fades in at the bottom, out over the last stretch, like the app's. */
  @keyframes bubble-rise {
    0% {
      transform: translateY(0);
      opacity: 0;
    }
    6% {
      opacity: var(--a);
    }
    70% {
      opacity: var(--a);
    }
    100% {
      transform: translateY(-95vh);
      opacity: 0;
    }
  }
  @keyframes bubble-wobble {
    from {
      transform: translateX(calc(var(--w) * -1));
    }
    to {
      transform: translateX(var(--w));
    }
  }

  /* ── Waves ── */
  .waves {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: clamp(56px, 8vw, 104px);
    overflow: hidden;
    pointer-events: none;
  }
  .waves.top {
    top: -1px;
    bottom: auto;
    transform: scaleY(-1);
  }
  .wave {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 200%;
    max-width: none;
    height: 100%;
    animation: drift 16s linear infinite;
  }
  .wave path {
    fill: var(--bg);
  }
  .wave.back {
    height: 120%;
    opacity: 0.35;
    animation-duration: 24s;
    animation-direction: reverse;
  }
  @keyframes drift {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  /* ── Hero ── */
  .hero {
    position: relative;
    background:
      radial-gradient(120% 90% at 78% 8%, rgba(62, 155, 199, 0.32), transparent 62%),
      linear-gradient(168deg, #0b3d5c 0%, #07314a 62%, #062940 100%);
    color: #fff;
    padding-top: clamp(56px, 8vw, 92px);
    padding-bottom: clamp(110px, 14vw, 168px);
    overflow: hidden;
  }
  .hero-in {
    position: relative;
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(32px, 6vw, 72px);
    align-items: center;
  }
  .badge {
    display: inline-block;
    margin: 0 0 22px;
    padding: 7px 15px;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.03em;
    color: rgba(255, 255, 255, 0.9);
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: var(--r-full);
  }
  .hero h1 {
    /* Three stacked lines on purpose: they mirror the app's welcome screen,
       where the same words stack the same way. */
    font-size: clamp(44px, 7.4vw, 76px);
    letter-spacing: -0.035em;
    margin-bottom: 24px;
  }
  .hero h1 .line {
    display: block;
  }
  .hero h1 .line:nth-child(2) {
    color: #8fd3ee;
  }
  .lede {
    font-size: clamp(17px, 1.9vw, 19.5px);
