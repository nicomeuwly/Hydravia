---
import { APP_STORE_URL } from '../config';

interface Props {
  label: string;
  /** Dark button on a light background, or light button on dark. */
  variant?: 'dark' | 'light';
}
const { label, variant = 'dark' } = Astro.props;

// Until the app is live there is no URL to point at. Rendering a <span> rather
// than a dead <a> keeps the promise honest: nothing looks clickable that
// cannot be clicked, and screen readers do not announce a phantom link.
const live = APP_STORE_URL.length > 0;
const Tag = live ? 'a' : 'span';
---

<Tag
  class:list={['btn', variant, !live && 'soon']}
  href={live ? APP_STORE_URL : undefined}
  aria-disabled={live ? undefined : 'true'}
>
  <svg viewBox="0 0 384 512" width="18" height="18" aria-hidden="true" focusable="false">
    <path
      fill="currentColor"
      d="M318.7 268.7c-.2-36.7 16.4-64.4 50-84.8-18.8-26.9-47.2-41.7-84.7-44.6-35.5-2.8-74.3 20.7-88.5 20.7-15 0-49.4-19.7-76.4-19.7C63.3 141.2 4 184.8 4 273.5q0 39.3 14.4 81.2c12.8 36.7 59 126.7 107.2 125.2 25.2-.6 43-17.9 75.8-17.9 31.8 0 48.3 17.9 76.4 17.9 48.6-.7 90.4-82.5 102.6-119.3-65.2-30.7-61.7-90-61.7-91.9zm-56.6-164.2c27.3-32.4 24.8-61.9 24-72.5-24.1 1.4-52 16.4-67.9 34.9-17.5 19.8-27.8 44.3-25.6 71.9 26.1 2 49.9-11.4 69.5-34.3z"
    ></path>
  </svg>
  <span>{label}</span>
</Tag>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    height: 56px;
    padding-inline: 28px;
    border-radius: var(--r-md);
    font-weight: 700;
    font-size: 16.5px;
    text-decoration: none;
    transition:
      transform 0.18s ease,
      box-shadow 0.18s ease,
      background 0.18s ease;
  }
  .dark {
    background: var(--primary-dark);
    color: #fff;
    box-shadow: var(--shadow-medium);
  }
  .light {
    background: #fff;
    color: var(--primary-dark);
    box-shadow: var(--shadow-heavy);
  }
  a.btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 26px rgba(11, 61, 92, 0.22);
  }
  a.btn:active {
    transform: translateY(0);
  }

  /* Pre-launch state: still on-brand, visibly not interactive. */
  .soon {
    opacity: 0.55;
    cursor: default;
  }
</style>
