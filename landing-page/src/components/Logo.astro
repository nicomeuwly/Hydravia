---
/**
 * The Hydravia mark: a droplet with a keyhole punched out of it.
 *
 * The path is copied verbatim from the app icon source
 * (hydravia/assets/source/app-icon-monochrome.svg) so the site and the icon
 * on the user's home screen are the same shape. `fill-rule="evenodd"` is what
 * knocks the keyhole out — without it the droplet fills solid.
 */
interface Props {
  size?: number;
  color?: string;
  class?: string;
}
const { size = 32, color = 'currentColor', class: cls } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 1024 1024"
  role="img"
  aria-hidden="true"
  focusable="false"
  class={cls}
>
  <g transform="translate(512 512) scale(20) translate(-10 -13.1)">
    <path
      fill-rule="evenodd"
      fill={color}
      d="M10 2C10 2 2.5 11.5 2.5 16.5C2.5 20.6 5.9 23.5 10 23.5C14.1 23.5 17.5 20.6 17.5 16.5C17.5 11.5 10 2 10 2ZM10 11.3a2.4 2.4 0 00-1.5 4.27L7.7 19.2a0.5 0.5 0 00.48.66h3.64a0.5 0.5 0 00.48-.66L11.5 15.57A2.4 2.4 0 0010 11.3Z"
    ></path>
  </g>
</svg>
