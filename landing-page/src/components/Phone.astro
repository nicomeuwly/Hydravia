---
/**
 * A screenshot in its iPhone mockup: real captures from the iOS simulator
 * (iPhone 17), framed by hand into a transparent webp (sources in
 * captures/). The shadow follows the frame's outline.
 */
interface Props {
  src: string;
  alt: string;
  /** Eager-load the hero shot; lazy-load the rest. */
  priority?: boolean;
  class?: string;
}
const { src, alt, priority = false, class: cls } = Astro.props;
---

<div class:list={['phone', cls]}>
  <img
    src={src}
    alt={alt}
    width="1206"
    height="2466"
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : 'auto'}
    decoding="async"
  />
</div>

<style>
  .phone {
    position: relative;
    width: 100%;
    max-width: 300px;
    filter: drop-shadow(0 24px 40px rgba(7, 49, 74, 0.3));
  }
  .phone img {
    width: 100%;
    height: auto;
    display: block;
  }
</style>
